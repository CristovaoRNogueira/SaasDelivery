# Porta HTTP no host. Mantenha 80 para que a lógica original de $url_sistema
# (que detecta "localhost/") funcione exatamente como no XAMPP.
APP_PORT=80

# Gere senhas fortes, ex.: openssl rand -hex 24
# Use apenas caracteres alfanuméricos (o valor é gravado na config do OpenLiteSpeed).
MARIADB_ROOT_PASSWORD=troque_por_uma_senha_forte
MARIADB_DATABASE=delivery_interativo
MARIADB_USER=delivery_app
MARIADB_PASSWORD=troque_por_uma_senha_forte

